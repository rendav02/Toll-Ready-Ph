# All optional. TollReady works with no keys using free public servers.

# Free OpenRouteService key (https://openrouteservice.org/dev/#/signup, no credit card).
# Adds a backup for routing and place search if the public servers are busy or down.
ORS_API_KEY=

# Set to "ors" to use OpenRouteService first instead of Valhalla.
# ROUTING_PROVIDER=ors

# Only if you self-host your own servers:
# VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# PHOTON_URL=https://photon.komoot.io

# Optional nicer map styles (free plans). Set ONE of these; it becomes the default map.
# MapTiler: https://cloud.maptiler.com/account/keys/   Stadia Maps: https://client.stadiamaps.com/
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_STADIA_KEY=
